# Local CSV source; keep the downloaded dataset outside Git tracking.
VIETJOBS_CSV_PATH=data/VietJobs_sample.csv

# Host CLI: replace change-me with PIPELINE_DB_PASSWORD when using Compose.
PIPELINE_DATABASE_URL=postgresql+psycopg2://job_pipeline:change-me@localhost:5433/job_pipeline
AI_PLATFORM_IMPORT_URL=http://localhost:8000/jobs/import
PIPELINE_DATA_ROOT=data
PIPELINE_SOURCE=vietjobs
# Public API page limit (integer >= 1); applies only to Arbeitnow.
ARBEITNOW_MAX_PAGES=5
ARBEITNOW_SCHEDULE=@daily
DELIVERY_PAYLOAD_PROFILE=ai_platform_v1
DELIVERY_MISSING_COMPANY=block
DELIVERY_MAX_BYTES=1000000
DELIVERY_MAX_RECORDS=20
DELIVERY_TIMEOUT_SECONDS=300
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_ENABLED=false
PIPELINE_EXPORT_ROOT=data/export

# Docker Compose: separate database roles; use URL-safe passwords (hex recommended).
POSTGRES_PASSWORD=replace-with-random-hex
PIPELINE_DB_PASSWORD=replace-with-random-hex
AIRFLOW_DB_PASSWORD=replace-with-random-hex
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-random-password
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-random-hex
AIRFLOW_UID=50000
